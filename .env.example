# Server Port (defaults to 3000 in AI Studio / Cloud Run)
PORT=3000

# GEMINI_API_KEY: Required for optional natural-language transport assistant (/api/ai/assist).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Firebase Admin SDK Credentials (server-side token verification, staff RBAC & FCM HTTP v1)
# On Google Cloud Run / GCP with attached service account, Application Default Credentials work automatically.
# Alternatively, supply explicit service account environment variables:
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Web Push VAPID Public Key (public client key exposed safely via /api/config/public)
FCM_VAPID_PUBLIC_KEY=""
VITE_FCM_VAPID_PUBLIC_KEY=""

# Optional Official / Licensed GTFS Static & GTFS-Realtime Feeds (HTTPS URLs)
# Leave empty if not connected; RoutePulse explicitly marks fallback modes as Estimated / Demo.
GTFS_STATIC_FEED_URL=""
GTFS_RT_VEHICLE_FEED_URL=""
GTFS_RT_TRIP_UPDATES_FEED_URL=""
GTFS_RT_ALERTS_FEED_URL=""
GTFS_RT_POLL_INTERVAL_MS=30000
